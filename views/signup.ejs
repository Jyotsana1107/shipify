<link rel="stylesheet" href="signup.css">
<div class="signup-card">
    <h1>Sign Up</h1>    
    <p class="subtitle">Create your account to start shopping.</p>
    <form id="signupForm">
        <label for="name">Username</label>
        <input id="name" name="name" placeholder="Enter your username" required>
        <label for="email">E-Mail</label>
        <input id="email" name="email" placeholder="Enter your email" required>
        <label for="password" type="password">Password</label>
        <input id="password" name="password" placeholder="Enter your password" type="password" required>
        <label for="confirmpassword">Confirm Password</label>
        <input id="confirmpassword" name="confirmpassword" placeholder="Confirm your password" type="password" required>
        <input id="submit" type="submit" value="Sign Up">
    </form>

    <a class="login-link" href="/login">Log In</a>
</div>

<script src="signup.js"></script>